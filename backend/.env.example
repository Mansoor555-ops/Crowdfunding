PORT=5000
# Real MongoDB connection string (Local or MongoDB Atlas)
# Example Local: mongodb://127.0.0.1:27017/fundrise
# Example Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/fundrise?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/fundrise

# Optional: Set to true only if you explicitly want to fall back to in-memory MongoDB when real DB is offline
ALLOW_MEMORY_DB_FALLBACK=false

JWT_ACCESS_SECRET=super_secret_access_token_key_123456
JWT_REFRESH_SECRET=super_secret_refresh_token_key_123456
CLOUDINARY_CLOUD_NAME=mock_cloud_name
CLOUDINARY_API_KEY=mock_api_key
CLOUDINARY_API_SECRET=mock_api_secret
STRIPE_SECRET_KEY=sk_test_mock_key
CLIENT_URL=http://localhost:5173
NODE_ENV=development
