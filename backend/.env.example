PORT=5000
# MongoDB Atlas Cloud Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/fundrise?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/fundrise?retryWrites=true&w=majority

JWT_ACCESS_SECRET=super_secret_access_token_key_123456
JWT_REFRESH_SECRET=super_secret_refresh_token_key_123456
CLOUDINARY_CLOUD_NAME=mock_cloud_name
CLOUDINARY_API_KEY=mock_api_key
CLOUDINARY_API_SECRET=mock_api_secret
STRIPE_SECRET_KEY=sk_test_mock_key
CLIENT_URL=http://localhost:5173
NODE_ENV=development
